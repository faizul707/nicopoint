    <div class="checkout-atmosphere" aria-hidden="true">
        <span class="checkout-orb checkout-orb-one"></span>
        <span class="checkout-orb checkout-orb-two"></span>
        <span class="checkout-ring checkout-ring-one"></span>
        <span class="checkout-ring checkout-ring-two"></span>
    </div>

    <section class="checkout-shell" aria-labelledby="checkout-title">
        <div class="checkout-container">

            <header class="checkout-header">
                <div class="checkout-eyebrow"><span></span> CHECKOUT</div>
                <h1 id="checkout-title">Review.<br><em>Confirm.</em></h1>
                <p>Complete each section below. Your information remains on this checkout page while you review the details.</p>
            </header>

            <nav class="checkout-progress" aria-label="Checkout progress">
                <button type="button" class="checkout-progress-step is-active" data-progress-step="1" aria-current="step">
                    <span>01</span><strong>Your details</strong>
                </button>
                <i aria-hidden="true"></i>
