<?php
declare(strict_types=1);

require_once __DIR__ . '/includes/core/config.php';

if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

$cart = $_SESSION['cart'] ?? [];
if (!is_array($cart)) {
    $cart = [];
}

$totalItems = 0;
$subtotal = 0.0;
$items = [];

foreach ($cart as $cartKey => $item) {
    if (!is_array($item)) {
        continue;
    }

    $quantity = max(1, min(999, (int) ($item['quantity'] ?? 1)));
    $price = max(0, (float) ($item['price'] ?? 0));
    $name = (string) ($item['name'] ?? 'Product');
    $image = (string) ($item['image'] ?? '');
    $strength = (string) ($item['strength'] ?? '');
    $lineTotal = $price * $quantity;

    $totalItems += $quantity;
    $subtotal += $lineTotal;

    $items[] = [
        'key' => (string) $cartKey,
        'name' => $name,
        'image' => $image,
        'strength' => $strength,
        'quantity' => $quantity,
        'price' => $price,
        'line_total' => $lineTotal,
    ];
}

if ($totalItems === 0) {
    header('Location: ' . BASE_URL . 'cart.php');
    exit;
}

$page = [
    'title' => 'Checkout | NIXGO9',
    'description' => 'Review order information and provide the details required for permitted order processing.',
    'keywords' => 'checkout, order review',
    'canonical' => BASE_URL . 'checkout.php',
    'body_class' => 'checkout-page'
];

require_once __DIR__ . '/includes/layout/header.php';
?>

<link rel="stylesheet" href="<?= CSS_PATH ?>checkout.css?v=2.0.0">

