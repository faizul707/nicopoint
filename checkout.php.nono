                        <strong><?= $totalItems ?> <?= $totalItems === 1 ? 'item' : 'items' ?></strong>
                    </div>

                    <div class="order-items">
                        <?php foreach ($items as $item): ?>
                            <article class="order-item">
                                <div class="order-item-image">
                                    <?php if ($item['image'] !== ''): ?>
                                        <img src="<?= IMG_PATH ?>products/<?= htmlspecialchars($item['image'], ENT_QUOTES, 'UTF-8') ?>" alt="<?= htmlspecialchars($item['name'], ENT_QUOTES, 'UTF-8') ?>" loading="lazy" decoding="async">
                                    <?php endif; ?>
                                </div>
                                <div class="order-item-copy">
                                    <span><?= htmlspecialchars($item['strength'], ENT_QUOTES, 'UTF-8') ?></span>
                                    <h3><?= htmlspecialchars($item['name'], ENT_QUOTES, 'UTF-8') ?></h3>
                                    <small>Qty <?= $item['quantity'] ?></small>
                                </div>
                                <strong>₹<?= number_format($item['line_total'], 0) ?></strong>
                            </article>
                        <?php endforeach; ?>
                    </div>

                    <div class="order-total-block">
                        <div><span>Subtotal</span><strong>₹<?= number_format($subtotal, 0) ?></strong></div>
                        <div><span>Delivery</span><strong>Calculated separately</strong></div>
                        <div class="grand-total"><span>Total</span><strong>₹<?= number_format($subtotal, 0) ?></strong></div>
                    </div>

                    <a class="back-cart" href="<?= BASE_URL ?>cart.php">← Back to selection</a>

                    <div class="order-notice">
                        <span>18+</span>
